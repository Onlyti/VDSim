# Write the git provenance header the Python bindings compile in.
#
# Run as a script at every build (cmake -DSRC=<source dir> -DOUT=<header> -P
# vdsim_git_info.cmake). The header is rewritten only when its content
# changes, so an unchanged HEAD does not recompile the bindings.
#
#   VDSIM_GIT_SHA   "<40-hex HEAD>" or "unknown" (no git, not a checkout)
#   VDSIM_GIT_DIRTY 1 when tracked files differ from HEAD, 0 when clean,
#                   -1 when unknown
find_package(Git QUIET)
set(sha "unknown")
set(dirty -1)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} -C ${SRC} rev-parse HEAD
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(rc EQUAL 0 AND out MATCHES "^[0-9a-f]+$")
        set(sha "${out}")
        execute_process(
            COMMAND ${GIT_EXECUTABLE} -C ${SRC} status --porcelain --untracked-files=no
            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(rc EQUAL 0)
            if(out STREQUAL "")
                set(dirty 0)
            else()
                set(dirty 1)
            endif()
        endif()
    endif()
endif()
set(content "// Generated by cmake/vdsim_git_info.cmake. Do not edit.\n#pragma once\n#define VDSIM_GIT_SHA \"${sha}\"\n#define VDSIM_GIT_DIRTY ${dirty}\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
