$-----------------------------------------------------------------------------
$ ioniq5_pac2002.tir — PUBLIC SYNTHETIC Pacejka-2002 coefficients.
$
$ NOT measured data. Hand-authored Ioniq5-class plant tyre for the VLA thesis
$ (load-dependent cornering stiffness + peak-mu load sensitivity). Safe to commit.
$-----------------------------------------------------------------------------
[MDI_HEADER]
FILE_TYPE          = 'tir'
FILE_VERSION       = 3.0
FILE_FORMAT        = 'ASCII'

[UNITS]
LENGTH             = 'meter'
FORCE              = 'newton'
ANGLE              = 'radians'
MASS               = 'kg'
TIME               = 'second'

[MODEL]
PROPERTY_FILE_FORMAT = 'MF_05'
USE_MODE           = 14
FITTYP             = 6
TYRESIDE           = 'LEFT'
LONGVL             = 16.0
VXLOW              = 1.0

[DIMENSION]
UNLOADED_RADIUS    = 0.338
WIDTH              = 0.255
ASPECT_RATIO       = 0.55
RIM_RADIUS         = 0.1905
RIM_WIDTH          = 0.16

[VERTICAL]
FNOMIN             = 5764
VERTICAL_STIFFNESS = 300000
VERTICAL_DAMPING   = 8000
BREFF              = 8.4
DREFF              = 0.27
FREFF              = 0.07

[LONG_SLIP_RANGE]
KPUMIN             = -1.5
KPUMAX             = 1.5

[SLIP_ANGLE_RANGE]
ALPMIN             = -1.5
ALPMAX             = 1.5

[INCLINATION_ANGLE_RANGE]
CAMMIN             = -0.175
CAMMAX             = 0.175

[VERTICAL_FORCE_RANGE]
FZMIN              = 200
FZMAX              = 12000

[SCALING_COEFFICIENTS]
LFZO               = 1.0
LCX                = 1.0
LMUX               = 1.0
LEX                = 1.0
