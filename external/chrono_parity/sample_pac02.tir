$-----------------------------------------------------------------------------
$ sample_pac02.tir — PUBLIC SYNTHETIC Pacejka-2002 coefficients.
$
$ NOT measured data. Representative passenger-car values, hand-authored for the
$ VDSim <-> Chrono Pac02 parity cross-check (see external/chrono_parity/README.md).
$ Safe to commit (the repo .gitignore *.tir rule has an explicit exception for this
$ one file). Confidential/measured .tir files are never committed.
$
$ TNO MF-Tyre / Pacejka-2002 flat key=value layout: read by both VDSim's parse_tir
$ (it picks the keys it needs, ignores the rest) and Chrono's file-driven Pac02 tire.
$-----------------------------------------------------------------------------
[UNITS]
LENGTH             = 'meter'
FORCE              = 'newton'
ANGLE              = 'radians'
MASS               = 'kg'
TIME               = 'second'

[MODEL]
FITTYP             = 6
TYRESIDE           = 'LEFT'
LONGVL             = 16.0
VXLOW              = 1.0

[DIMENSION]
UNLOADED_RADIUS    = 0.31
WIDTH              = 0.205
ASPECT_RATIO       = 0.55
RIM_RADIUS         = 0.1905
RIM_WIDTH          = 0.16

[VERTICAL]
FNOMIN             = 4000
VERTICAL_STIFFNESS = 220000
VERTICAL_DAMPING   = 8000
BREFF              = 8.4
DREFF              = 0.27
FREFF              = 0.07

[LONG_SLIP_RANGE]
KPUMIN             = -1.5
KPUMAX             = 1.5

[SLIP_ANGLE_RANGE]
ALPMIN             = -1.5
ALPMAX             = 1.5

[INCLINATION_ANGLE_RANGE]
CAMMIN             = -0.175
CAMMAX             = 0.175

[VERTICAL_FORCE_RANGE]
FZMIN              = 200
FZMAX              = 10000

[SCALING_COEFFICIENTS]
LFZO               = 1.0
LCX                = 1.0
LMUX               = 1.0
LEX                = 1.0
LKX                = 1.0
LHX                = 1.0
LVX                = 1.0
LCY                = 1.0
LMUY               = 1.0
LEY                = 1.0
LKY                = 1.0
LHY                = 1.0
LVY                = 1.0
LTR                = 1.0
LRES               = 1.0
LXAL               = 1.0
LYKA               = 1.0
LVYKA              = 1.0
LS                 = 1.0
LMX                = 1.0
LMY                = 1.0

[LONGITUDINAL_COEFFICIENTS]
PCX1               = 1.65
